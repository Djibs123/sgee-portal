NODE_ENV=development
PORT=3000

# Base de dev locale : `pnpm db:start` (PGlite, port 5433) ou un PostgreSQL 18 réel.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable"
# Base fantôme pour `prisma migrate dev` uniquement.
SHADOW_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5435/postgres?sslmode=disable"
DATABASE_POOL_MAX=5

# Secrets : au moins 32 caractères aléatoires, différents entre eux.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-a-strong-secret"
ADMIN_JWT_SECRET="replace-with-another-strong-secret"

# Chiffrement des IBAN (AES-256-GCM) : 32 octets en base64, obligatoire en production.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Ne jamais changer cette clé sans rechiffrer les données existantes.
# DATA_ENCRYPTION_KEY=""

AUTH_COOKIE_NAME="sgee_session"
ADMIN_AUTH_COOKIE_NAME="sgee_admin_session"
# Origines autorisées (CORS + contrôle CSRF), séparées par des virgules.
FRONTEND_ORIGIN="http://localhost:5173"
# Derrière un reverse proxy : nombre de sauts (ex. 1). Laisser false sinon.
TRUST_PROXY=false
UPLOAD_DIR="uploads/student-documents"
MAX_UPLOAD_SIZE_MB="5"
