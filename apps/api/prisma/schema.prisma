generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RibStatus {
  PENDING
  VALIDATED
  REJECTED
}

enum StudentDocumentStatus {
  REQUIRED
  PENDING
  VALIDATED
  REJECTED
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

enum SessionSubject {
  STUDENT
  ADMIN
  APPLICANT
}

enum AuditActorType {
  STUDENT
  ADMIN
  APPLICANT
  SYSTEM
}

/// État de la bourse d'un boursier.
enum ScholarshipStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PAID
  PENDING
  CANCELLED
}

enum CampaignType {
  RENEWAL
  NEW_APPLICATION
}

/// Niveau d'études codifié (le cycle se déduit du code).
enum StudyLevel {
  PREPA1
  PREPA2
  BTS1
  BTS2
  L1
  L2
  L3
  M1
  M2
  ING1
  ING2
  ING3
  D1
  D2
  D3
  D4
  OTHER
}

enum StudyCycle {
  PREPA
  BTS
  LICENCE
  MASTER
  INGENIEUR
  DOCTORAT
  OTHER
}

/// Résultat de l'année précédente : admis, redoublant, ajourné.
enum AcademicResult {
  PASSED
  REPEATED
  FAILED
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  INCOMPLETE
  APPROVED
  REJECTED
  WITHDRAWN
}

model Student {
  id                  String            @id @default(uuid())
  studentNumber       String            @unique
  firstName           String
  lastName            String
  email               String            @unique
  birthDate           DateTime
  scholarshipStatus   ScholarshipStatus @default(ACTIVE)
  /// Niveau courant codifié ; `level` reste le libellé hérité du système legacy.
  levelCode           StudyLevel?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @default(now()) @updatedAt
  passwordHash        String?
  lastLoginAt         DateTime?
  failedLoginAttempts Int               @default(0)
  lockedUntil         DateTime?

  matricule               String?
  level                   String?
  field                   String?
  academy                 String?
  country                 String?
  academicYear            String?
  scholarshipType         String?
  paymentMethod           String?
  birthCity               String?
  birthCountry            String?
  gender                  String?
  familySituation         String?
  budget                  String?
  allocationMonthlyAmount Decimal?  @db.Decimal(10, 2)
  allocationCurrency      String?
  allocationCfaAmount     Int?
  totalPaidAmount         Decimal?  @db.Decimal(10, 2)
  progressPercent         Int?
  startDate               DateTime?
  endDate                 DateTime?
  attributionNumber       String?
  arrivalDate             DateTime?
  lastProcessingDate      DateTime?

  payments      Payment[]
  ribs          Rib[]
  cursus        CursusEntry[]
  documents     StudentDocument[]
  sessions      Session[]
  requests      ScholarshipRequest[]
  notifications Notification[]
  applicant     Applicant?

  @@index([matricule])
  @@index([scholarshipStatus])
  @@index([academicYear])
}

model AdminUser {
  id                  String    @id @default(uuid())
  email               String    @unique
  name                String
  passwordHash        String
  role                AdminRole @default(ADMIN)
  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions        Session[]
  decidedRequests ScholarshipRequest[]

  @@index([role])
}

/// Candidat à une première bourse. Devient boursier (`studentId`) à l'attribution.
model Applicant {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String
  firstName           String
  lastName            String
  birthDate           DateTime  @db.Date
  phone               String?
  nationalIdNumber    String?
  emailVerifiedAt     DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  studentId           String?   @unique
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  student       Student?             @relation(fields: [studentId], references: [id], onDelete: SetNull)
  requests      ScholarshipRequest[]
  sessions      Session[]
  notifications Notification[]
}

/// Année universitaire (ex. code `2026-2027`, libellé `2026/2027`).
model AcademicYear {
  id        String   @id @default(uuid())
  code      String   @unique
  label     String
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns Campaign[]
}

/// Campagne annuelle de renouvellement ou de candidature. Son statut (à venir,
/// ouverte, clôturée) se calcule à partir des dates : aucune tâche planifiée.
model Campaign {
  id                String       @id @default(uuid())
  type              CampaignType
  academicYearId    String
  title             String
  instructions      String?
  opensAt           DateTime
  closesAt          DateTime
  /// Clôture anticipée décidée par un super-admin.
  closedAt          DateTime?
  /// Âge maximal hors doctorat (candidatures) ; 30 ans selon le règlement SGEE.
  maxAgeNonDoctoral Int?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  academicYear AcademicYear          @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  requirements CampaignRequirement[]
  requests     ScholarshipRequest[]

  @@unique([type, academicYearId])
  @@index([opensAt, closesAt])
}

/// Pièce exigée par une campagne, éventuellement limitée à certains cycles.
model CampaignRequirement {
  id               String       @id @default(uuid())
  campaignId       String
  documentTypeCode String
  /// Cycles concernés ; liste vide = tous les cycles.
  cycles           StudyCycle[]
  isRequired       Boolean      @default(true)
  sortOrder        Int          @default(0)

  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  documentType DocumentType @relation(fields: [documentTypeCode], references: [code])

  @@unique([campaignId, documentTypeCode])
}

/// Demande de renouvellement (boursier) ou de première bourse (candidat).
model ScholarshipRequest {
  id                   String          @id @default(uuid())
  /// Référence lisible, ex. REN-2026-000123 ou CAN-2026-000045.
  reference            String          @unique
  type                 CampaignType
  campaignId           String
  studentId            String?
  applicantId          String?
  status               RequestStatus   @default(DRAFT)
  // Situation pour l'année demandée
  targetLevel          StudyLevel?
  institution          String?
  city                 String?
  country              String?
  fieldOfStudy         String?
  programName          String?
  // Année précédente (renouvellement)
  previousLevel        StudyLevel?
  previousResult       AcademicResult?
  previousAverage      Decimal?        @db.Decimal(4, 2)
  changedField         Boolean         @default(false)
  changedInstitution   Boolean         @default(false)
  // Candidature
  baccalaureateSeries  String?
  baccalaureateYear    Int?
  baccalaureateMention String?
  baccalaureateAverage Decimal?        @db.Decimal(4, 2)
  motivation           String?
  honorDeclarationAt   DateTime?
  /// Alertes d'éligibilité figées à la soumission, pour l'instructeur.
  eligibilityWarnings  Json?
  submittedAt          DateTime?
  decidedAt            DateTime?
  decidedById          String?
  decisionComment      String?
  /// Verrou optimiste : incrémenté à chaque modification.
  version              Int             @default(0)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  campaign  Campaign               @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  student   Student?               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  applicant Applicant?             @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  decidedBy AdminUser?             @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  documents RequestDocument[]
  history   RequestStatusHistory[]

  @@unique([studentId, campaignId])
  @@unique([applicantId, campaignId])
  @@index([campaignId, status])
  @@index([status, submittedAt])
}

/// Pièce justificative rattachée à une demande (un fichier par type de pièce).
model RequestDocument {
  id               String                @id @default(uuid())
  requestId        String
  documentTypeCode String
  status           StudentDocumentStatus @default(REQUIRED)
  required         Boolean               @default(true)
  fileName         String?
  originalName     String?
  mimeType         String?
  size             Int?
  storagePath      String?
  submittedAt      DateTime?
  reviewedAt       DateTime?
  reviewComment    String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  request      ScholarshipRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  documentType DocumentType       @relation(fields: [documentTypeCode], references: [code])

  @@unique([requestId, documentTypeCode])
}

/// Historique des changements de statut d'une demande (traçabilité).
model RequestStatusHistory {
  id         String         @id @default(uuid())
  requestId  String
  fromStatus RequestStatus?
  toStatus   RequestStatus
  actorType  AuditActorType
  actorId    String?
  comment    String?
  createdAt  DateTime       @default(now())

  request ScholarshipRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

/// Notification in-app pour un boursier ou un candidat.
model Notification {
  id          String    @id @default(uuid())
  studentId   String?
  applicantId String?
  type        String
  title       String
  body        String
  link        String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  student   Student?   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  applicant Applicant? @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([studentId, readAt])
  @@index([applicantId, readAt])
}

/// Session serveur : le JWT ne porte que son identifiant (`sid`), ce qui permet la révocation.
model Session {
  id          String         @id @default(uuid())
  subjectType SessionSubject
  studentId   String?
  adminUserId String?
  applicantId String?
  createdAt   DateTime       @default(now())
  lastSeenAt  DateTime       @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  ip          String?
  userAgent   String?

  student   Student?   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  applicant Applicant? @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([adminUserId])
  @@index([applicantId])
  @@index([expiresAt])
}

/// Journal d'audit append-only des actions sensibles.
model AuditLog {
  id         String         @id @default(uuid())
  actorType  AuditActorType
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime       @default(now())

  @@index([entityType, entityId])
  @@index([actorType, actorId])
  @@index([action])
  @@index([createdAt])
}

model Payment {
  id           String        @id @default(uuid())
  studentId    String
  month        String
  academicYear String
  paymentDate  DateTime
  amount       Decimal       @db.Decimal(10, 2)
  currency     String
  baseAmount   Decimal       @db.Decimal(10, 2)
  status       PaymentStatus @default(PAID)
  reference    String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([academicYear])
  @@index([paymentDate])
}

/// Historique des RIB d'un étudiant. Au plus un RIB actif (validé, utilisé pour les
/// versements) et un RIB en attente : garanti par les index uniques sur les slots,
/// qui valent `true` ou `null` (plusieurs NULL sont permis en PostgreSQL).
model Rib {
  id              String    @id @default(uuid())
  studentId       String
  activeSlot      Boolean?
  pendingSlot     Boolean?
  supersededAt    DateTime?
  bankName        String
  holderName      String
  /// Ancienne colonne en clair, vidée par `prisma/scripts/encrypt-existing-ibans.ts`.
  iban            String?
  ibanCiphertext  String?
  ibanFingerprint String?
  ibanLast4       String?
  ibanMasked      String
  bic             String
  address         String
  phone           String
  email           String
  status          RibStatus @default(PENDING)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewComment   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, activeSlot])
  @@unique([studentId, pendingSlot])
  @@index([studentId])
  @@index([status])
  @@index([ibanFingerprint])
}

model CursusEntry {
  id           String          @id @default(uuid())
  studentId    String
  academicYear String
  institution  String
  level        String
  specialty    String
  diploma      String
  status       String
  /// Niveau codifié et résultat, utilisés par les règles de redoublement.
  levelCode    StudyLevel?
  result       AcademicResult?
  isCurrent    Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([academicYear])
  @@index([isCurrent])
}

/// Catalogue des pièces justificatives (dossier, renouvellement, candidature).
model DocumentType {
  code        String   @id
  label       String
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studentDocuments     StudentDocument[]
  campaignRequirements CampaignRequirement[]
  requestDocuments     RequestDocument[]
}

model StudentDocument {
  id            String                @id @default(uuid())
  studentId     String
  name          String
  /// Code du catalogue `DocumentType`.
  type          String
  status        StudentDocumentStatus @default(REQUIRED)
  required      Boolean               @default(true)
  submittedAt   DateTime?
  reviewedAt    DateTime?
  reviewComment String?
  fileName      String?
  originalName  String?
  mimeType      String?
  size          Int?
  storagePath   String?
  uploadedAt    DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  documentType DocumentType @relation(fields: [type], references: [code], onUpdate: Cascade)

  @@index([studentId])
  @@index([type])
  @@index([status])
  @@index([uploadedAt])
}
