generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RibStatus {
  PENDING
  VALIDATED
  REJECTED
}

enum StudentDocumentStatus {
  REQUIRED
  PENDING
  VALIDATED
  REJECTED
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

enum SessionSubject {
  STUDENT
  ADMIN
  APPLICANT
}

enum AuditActorType {
  STUDENT
  ADMIN
  APPLICANT
  SYSTEM
}

model Student {
  id                  String    @id @default(uuid())
  studentNumber       String    @unique
  firstName           String
  lastName            String
  email               String    @unique
  birthDate           DateTime
  scholarshipStatus   String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt
  passwordHash        String?
  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  matricule               String?
  level                   String?
  field                   String?
  academy                 String?
  country                 String?
  academicYear            String?
  scholarshipType         String?
  paymentMethod           String?
  birthCity               String?
  birthCountry            String?
  gender                  String?
  familySituation         String?
  budget                  String?
  allocationMonthlyAmount Decimal?  @db.Decimal(10, 2)
  allocationCurrency      String?
  allocationCfaAmount     Int?
  totalPaidAmount         Decimal?  @db.Decimal(10, 2)
  progressPercent         Int?
  startDate               DateTime?
  endDate                 DateTime?
  attributionNumber       String?
  arrivalDate             DateTime?
  lastProcessingDate      DateTime?

  payments  Payment[]
  rib       Rib?
  cursus    CursusEntry[]
  documents StudentDocument[]
  sessions  Session[]

  @@index([matricule])
  @@index([academicYear])
}

model AdminUser {
  id                  String    @id @default(uuid())
  email               String    @unique
  name                String
  passwordHash        String
  role                AdminRole @default(ADMIN)
  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions Session[]

  @@index([role])
}

/// Session serveur : le JWT ne porte que son identifiant (`sid`), ce qui permet la révocation.
model Session {
  id          String         @id @default(uuid())
  subjectType SessionSubject
  studentId   String?
  adminUserId String?
  createdAt   DateTime       @default(now())
  lastSeenAt  DateTime       @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  ip          String?
  userAgent   String?

  student   Student?   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([adminUserId])
  @@index([expiresAt])
}

/// Journal d'audit append-only des actions sensibles.
model AuditLog {
  id         String         @id @default(uuid())
  actorType  AuditActorType
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime       @default(now())

  @@index([entityType, entityId])
  @@index([actorType, actorId])
  @@index([action])
  @@index([createdAt])
}

model Payment {
  id           String   @id @default(uuid())
  studentId    String
  month        String
  academicYear String
  paymentDate  DateTime
  amount       Decimal  @db.Decimal(10, 2)
  currency     String
  baseAmount   Decimal  @db.Decimal(10, 2)
  status       String
  reference    String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([academicYear])
  @@index([paymentDate])
}

model Rib {
  id            String    @id @default(uuid())
  studentId     String    @unique
  bankName      String
  holderName    String
  iban          String
  ibanMasked    String
  bic           String
  address       String
  phone         String
  email         String
  status        RibStatus @default(PENDING)
  submittedAt   DateTime?
  reviewedAt    DateTime?
  reviewComment String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
}

model CursusEntry {
  id           String   @id @default(uuid())
  studentId    String
  academicYear String
  institution  String
  level        String
  specialty    String
  diploma      String
  status       String
  isCurrent    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([academicYear])
  @@index([isCurrent])
}

/// Catalogue des pièces justificatives (dossier, renouvellement, candidature).
model DocumentType {
  code        String   @id
  label       String
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studentDocuments StudentDocument[]
}

model StudentDocument {
  id            String                @id @default(uuid())
  studentId     String
  name          String
  /// Code du catalogue `DocumentType`.
  type          String
  status        StudentDocumentStatus @default(REQUIRED)
  required      Boolean               @default(true)
  submittedAt   DateTime?
  reviewedAt    DateTime?
  reviewComment String?
  fileName      String?
  originalName  String?
  mimeType      String?
  size          Int?
  storagePath   String?
  uploadedAt    DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  documentType DocumentType @relation(fields: [type], references: [code], onUpdate: Cascade)

  @@index([studentId])
  @@index([type])
  @@index([status])
  @@index([uploadedAt])
}
