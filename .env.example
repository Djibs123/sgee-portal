# Variables de `docker compose` (copier en `.env`, jamais versionné).
# Générer chaque secret séparément :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
POSTGRES_PASSWORD=
JWT_SECRET=
ADMIN_JWT_SECRET=

# 32 octets en base64. Ne jamais la changer sans rechiffrer les IBAN existants.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# URL publique du portail (liens des e-mails, contrôle d'origine CSRF/CORS).
PUBLIC_APP_URL=http://localhost:8080

# Par défaut, Mailpit capture les e-mails. En production : smtps://utilisateur:motdepasse@hote:465
# SMTP_URL=
# MAIL_FROM=SGEE <no-reply@sgee.sn>
